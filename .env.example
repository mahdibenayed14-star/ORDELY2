# Ordely — variables d'environnement (toutes facultatives)
# Aucune clé n'est nécessaire pour le mode gratuit : reconnaissance et voix du navigateur.
# Copiez ce fichier en « .env » pour un essai local : cp .env.example .env

PORT=10000
# Le mode serveur persiste seulement les données fictives de la démo.
DATA_FILE=./data/database.json
ENABLE_DEMO_RESET=true

# ---------------------------------------------------------------------------
# VOIX TUNISIENNE (DERJA) — LA SEULE CHOSE À FAIRE POUR L'AVOIR VRAIMENT
# ---------------------------------------------------------------------------
# 1) Ouvrez https://baarcha.tn/platform  (connexion Google, aucune carte bancaire)
# 2) Créez une clé : elle ressemble à pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
# 3) Collez-la ci-dessous (ou dans Render → Environment → BAARCHA_API_KEY)
# Avec cette seule clé, Ordely obtient :
#   • Dido  → la voix tunisienne (synthèse, PCM 24 kHz)
#   • Fennec → la reconnaissance de la parole tunisienne
# Nouveau compte : crédit d'essai offert (≈ 1 000 000 de caractères Dido ou 2 h de Fennec).
BAARCHA_API_KEY=
# Voix Dido : laissez vide pour la voix par défaut, ou « female », ou l'identifiant
# d'une voix clonée (vc_…) créée sur votre compte. Liste : GET /api/v1/voices.
BAARCHA_VOICE_ID=
# Avancé : ne changer que pour un proxy ou un déploiement Baarcha auto-hébergé.
# BAARCHA_BASE_URL=https://baarcha.tn/api/v1
# BAARCHA_STT_MODEL=fennec
# Durée d'un segment de reconnaissance en millisecondes (défaut 6000).
# BAARCHA_STT_SEGMENT_MS=6000

# ---------------------------------------------------------------------------
# SECOURS DURABLE GRATUIT : voix Azure ar-TN (offre F0, 500 000 caractères/mois)
# Utile quand le crédit Baarcha est épuisé ou pour varier les voix (Hedi / Reem).
# ---------------------------------------------------------------------------
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOICE=ar-TN-HediNeural        # ou ar-TN-ReemNeural

# ---------------------------------------------------------------------------
# FACULTATIF — moteurs supplémentaires (aucun n'est requis)
# ---------------------------------------------------------------------------
# Forcer un moteur : baarcha | azure | elevenlabs  (voix) / baarcha | deepgram (reconnaissance)
# TTS_PROVIDER=
# STT_PROVIDER=
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=ar-TN
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ---------------------------------------------------------------------------
# RÉGLAGES DE LA DÉMO
# ---------------------------------------------------------------------------
# Cache disque de la voix : une phrase déjà rendue est rejouée sans consommer de crédit.
TTS_CACHE=true
# TTS_CACHE_DIR=./data/tts-cache
# Les sessions streaming sont plafonnées à 10 minutes côté serveur.
STREAM_MAX_MINUTES=10
